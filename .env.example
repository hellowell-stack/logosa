# ─── Site ────────────────────────────────────────────────────────────────
# The real domain. Used for canonical URLs, the sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://logosa.com.np

# ─── Bookings, enquiries and the admin ───────────────────────────────────
# MongoDB (Atlas, or any MongoDB). Every booking request and enquiry is stored
# here and managed at /admin. See LAUNCH.md §3.
#   · Unset in development: a local MongoDB is started for you, storing its
#     data in .data/mongo (first run downloads the server once per machine).
#   · Unset in production: booking requests and /admin switch themselves off
#     and say so, rather than losing data.
# MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
# Database name inside the cluster. Defaults to "logosa".
# MONGODB_DB=logosa

# Required in production to create the first admin account at /admin/setup.
# Any long random string (e.g. `openssl rand -base64 32`). Once the owner
# account exists the setup page is closed for good, and this can be removed.
# ADMIN_SETUP_TOKEN=

# ─── Email ───────────────────────────────────────────────────────────────
# Sends staff notifications, and — to travellers — booking links, quotes and
# confirmations. Without it everything is still recorded in /admin; nobody
# is emailed, and staff send travellers their links by hand.
#
# INQUIRY_FROM must be an address on a domain verified in Resend. Resend's
# default test sender only delivers to your own Resend account, so without a
# verified domain travellers would never receive their quotes.
# RESEND_API_KEY=
# INQUIRY_FROM=Logosa <bookings@logosa.com.np>
# INQUIRY_TO=hello@logosa.com.np

# Optional — also POST each enquiry as JSON to a webhook (Zapier, Make, a CRM).
# INQUIRY_WEBHOOK_URL=

# ─── Map ─────────────────────────────────────────────────────────────────
# Optional. Without it the map section renders the drawn atlas fallback,
# which is a designed state rather than a broken one.
# Restrict this token to your domain — it ships to the browser.
# NEXT_PUBLIC_MAPBOX_TOKEN=

# ─── Conditions ──────────────────────────────────────────────────────────
# Live weather comes from Open-Meteo, which needs no key. Set to 1 to turn
# the feature off entirely; the UI then hides itself rather than erroring.
# CONDITIONS_DISABLED=0
